#!/usr/bin/python3

import sys
import os
import subprocess
import argparse
import time
import datetime
import yaml


# -----------------------------------------------------------------------------
# Read container config
# -----------------------------------------------------------------------------
def readconf(input0):
    global cfg

    global UTILITY_HOSTNAME
    global IMAGE_NAME
    global IMAGE_VERSION
    global SSH_PORT

    UTILITY_HOSTNAME = None
    IMAGE_NAME = None
    IMAGE_VERSION = None
    SSH_PORT = None

    with open(input0.config_file, 'r') as ymlfile:
        cfg = yaml.safe_load(ymlfile)

    # Utility hostname
    if "UTILITY_HOSTNAME" in cfg["CONTAINER"]:
        UTILITY_HOSTNAME = cfg["CONTAINER"]["UTILITY_HOSTNAME"]
    if UTILITY_HOSTNAME is None:
        print("-- [ERROR] Utility hostname should be provided inside rclmgr.yml file... --")
        sys.exit(1)

    # Image Name
    if "IMAGE_NAME" in cfg["CONTAINER"]:
        IMAGE_NAME = str(cfg["CONTAINER"]["IMAGE_NAME"])
    if IMAGE_NAME is None:
        print("-- [ERROR] Image name should be provided inside rclmgr.yml file... --")
        sys.exit(1)

    # Image Version
    if "IMAGE_VERSION" in cfg["CONTAINER"]:
        IMAGE_VERSION = str(cfg["CONTAINER"]["IMAGE_VERSION"])
    if IMAGE_VERSION is None:
        print("-- [ERROR] Image version should be provided inside rclmgr.yml file... --")

    # SSH Port, default 10022
    if "SSH_PORT" in cfg["CONTAINER"]:
        SSH_PORT = str(cfg["CONTAINER"]["SSH_PORT"])
    if SSH_PORT is None:
        print("-- [ERROR] SSH port should be provided inside rclmgr.yml file... --")
        sys.exit(1)

    checkdir()


# -----------------------------------------------------------------------------
# Check if required directories exist
# -----------------------------------------------------------------------------
def checkdir():
    if not (os.path.isdir(cfg["CONTAINER"]["LOG"])):
        os.makedirs(cfg["CONTAINER"]["LOG"])
        print("-- [INFO] Log directory does not exist, created now --")
    if not (os.path.isdir(cfg["CONTAINER"]["BKUP"])):
        os.makedirs(cfg["CONTAINER"]["BKUP"])
        print("-- [INFO] Backup directory does not exist, created now --")


# -----------------------------------------------------------------------------
# Deprecation warning
# -----------------------------------------------------------------------------
def rclmgr_EOL_warning():
    ALLOW_RCLMGR = os.getenv('ALLOW_RCLMGR')
    if ALLOW_RCLMGR is None:
        print("-- [ERROR] You cannot run rclmgr directly, use startRCLcont instead")
        print("           If you still want to run rclmgr directly, set ALLOW_RCLMGR to value 1 on the shell")
        print("           but be aware this is not supported and any error you encounter you need to run with startRCLcont")
        time.sleep(2)
        sys.exit(1)
    elif ALLOW_RCLMGR == "1":
        print("-- [WARNING] You should not run rclmgr directly, use startRCLcont instead")
        print("-- [WARNING] rclmgr is going to be deprecated in a future release")
        print("-- [WARNING] Be aware that any error you encounter you need to reproduce running startRCLcont")
        time.sleep(5)
    else:
        print("-- [ERROR] You cannot run rclmgr directly, use startRCLcont instead")
        print("           If you still want to run rclmgr directly, set ALLOW_RCLMGR to value 1 on the shell")
        print("           Now it has a value but it is not set to '1'.")
        print("           Be aware this is not supported and any error you encounter you need to run with startRCLcont")
        time.sleep(2)
        sys.exit(1)

# -----------------------------------------------------------------------------
# Clean nftables
# -----------------------------------------------------------------------------
def clean_nftables():
    if ( subprocess.call("which nft > /dev/null 2>&1", shell=True) == 0 ):
        cmd = "nft -a list chain ip nat PREROUTING 2> /dev/null | grep 'NETAVARK-HOSTPORT-DNAT' > /dev/null 2>&1 && " + \
                "nft delete rule ip nat PREROUTING handle " + \
                "$(nft -a list chain ip nat PREROUTING | grep 'NETAVARK-HOSTPORT-DNAT' " + \
                "| awk '{print $(NF)}') 2> /dev/null || true"
        subprocess.call(cmd, shell=True)
        cmd = "nft -a list chain ip nat OUTPUT 2> /dev/null | grep 'NETAVARK-HOSTPORT-DNAT' > /dev/null 2>&1 && " + \
                "nft delete rule ip nat OUTPUT handle " + \
                "$(nft -a list chain ip nat OUTPUT | grep 'NETAVARK-HOSTPORT-DNAT' " + \
                "| awk '{print $(NF)}') 2> /dev/null || true"
        subprocess.call(cmd, shell=True)
        cmd = "nft delete chain ip nat NETAVARK-HOSTPORT-DNAT 2> /dev/null  || true"
        subprocess.call(cmd, shell=True)
        cmd = "nft -a list chain ip nat POSTROUTING 2> /dev/null | grep 'NETAVARK-HOSTPORT-MASQ' > /dev/null 2>&1 && " + \
                "nft delete rule ip nat POSTROUTING handle " + \
                "$(nft -a list chain ip nat POSTROUTING | grep 'NETAVARK-HOSTPORT-MASQ' " + \
                "| awk '{print $(NF)}') 2> /dev/null || true"
        subprocess.call(cmd, shell=True)
        cmd = "nft delete chain ip nat NETAVARK-HOSTPORT-MASQ 2> /dev/null  || true"
        subprocess.call(cmd, shell=True)
        cmd = "nft delete chain ip nat NETAVARK-DN-1D8721804F16F 2> /dev/null || true"
        subprocess.call(cmd, shell=True)
        cmd = "nft delete chain ip nat NETAVARK-HOSTPORT-SETMARK 2> /dev/null || true"
        subprocess.call(cmd, shell=True)
        cmd = "nft -a list chain ip nat POSTROUTING 2> /dev/null | grep 'NETAVARK-1D8721804F16F' > /dev/null 2>&1 && " + \
                "nft delete rule ip nat POSTROUTING handle " + \
                "$(nft -a list chain ip nat POSTROUTING | grep 'NETAVARK-1D8721804F16F' " + \
                "| awk '{print $(NF)}') 2> /dev/null || true"
        subprocess.call(cmd, shell=True)
        cmd = "nft delete chain ip nat NETAVARK-1D8721804F16F 2> /dev/null || true"
        subprocess.call(cmd, shell=True)
        cmd = "nft -a list chain ip filter FORWARD 2> /dev/null | grep 'NETAVARK_FORWARD' > /dev/null 2>&1 && " + \
                "nft delete rule ip filter FORWARD handle " + \
                "$(nft -a list chain ip filter FORWARD | grep 'NETAVARK_FORWARD' " + \
                "| awk '{print $(NF)}') 2> /dev/null || true"
        subprocess.call(cmd, shell=True)
        cmd = "nft delete chain ip filter NETAVARK_FORWARD 2> /dev/null || true"
        subprocess.call(cmd, shell=True)

# -----------------------------------------------------------------------------
# Run Container
# -----------------------------------------------------------------------------
def run_container(force, is_startrclcont=False):
    global UTILITY_HOSTNAME
    global SSH_PORT
    global IMAGE_NAME
    global IMAGE_VERSION

    rc = 1

    if not is_startrclcont:
        rclmgr_EOL_warning()

    print(f"-- [INFO] Running the container image: {IMAGE_NAME}:{IMAGE_VERSION}")

    cont = cfg["CONTAINER"]["CONTAINER_HOSTNAME"]

    if force:
        print("-- [WARNING] The '-x' or '--force' option removes containers that are in the EXIT state --")
        cmd = f"systemctl --user stop container-{cont} && podman container rm -f {cont}"
        subprocess.call(cmd, shell=True)

    cmd = f"podman ps -a --format {{{{.Names}}}} --filter name={cont}"
    returned_output = subprocess.check_output(cmd, shell=True)

    if returned_output != b"":
        print(f"-- [INFO] Container '{cont}' already exists --")
        cmd = f"podman ps -a --format {{{{.Status}}}} --filter name={cont}"
        returned_output = subprocess.check_output(cmd, shell=True)

        if b"Exited" in returned_output:
            print("-- [INFO] Already installed container found on EXIT state. Trying to restart the existing container --")
            print("-- [INFO] It will be the same old container which was exited earlier with all data intact --")
            time.sleep(3)
            clean_nftables()

            subprocess.call(f"systemctl --user start container-{cont}.service", shell=True)
        elif b"Created" in returned_output:
            print("-- [INFO] Already installed container found on CREATED state. Trying to start the existing container --")
            time.sleep(3)
            clean_nftables()

            subprocess.call(f"systemctl --user start container-{cont}.service", shell=True)
        else:
            print("-- [INFO] Container with ACTIVE state found. Trying to attach the existing container --")

        print(f'-- [INFO] Container resumed/started. Check "systemctl --user status container-{cont}.service"')
        print(f'-- [INFO] Re-login to container using "podman exec -it {cont} /bin/bash" command --')
    else:
        print("-- [INFO] Automatic initialization of the container begin shortly --")
        print("-- [INFO] Startup can take several minutes. --")
        time.sleep(3)

        clean_nftables()

        # ------------------------------------
        # Reading serial number of utility host
        # ------------------------------------
        serial = ""
        cmd = "sudo cat /sys/devices/virtual/dmi/id/product_serial"
        serial = subprocess.check_output(cmd, shell=True)
        if serial == b"":
            print("-- [ERROR] Not able to read the serial number of the IBM Utility host... --")
            sys.exit(1)

        # ------------------------------------
        # Forming correct podman create command.
        # ------------------------------------
        c = cfg["CONTAINER"]
        serial_str = serial.decode().strip()
        cmd = (
            f'podman create --syslog'
            f' --hostname="{c["CONTAINER_HOSTNAME"]}.{c["CONTAINER_DOMAIN_NAME"]}"'
            f' --name {c["CONTAINER_HOSTNAME"]}'
            f' -v {c["LOG"]}:/var/log/'
            f' -v {c["BKUP"]}:/home/backup/'
            f' --cap-add=SYS_CHROOT'
        )

        container_env_details = (
            f' --env "RCL_CONTAINER=Y"'
            f' --env "UTILITY_HOSTNAME={UTILITY_HOSTNAME}"'
            f' --env "UTILITY_CAMPUS_IP={c["CAMPUS_INTERFACE_IP"]}"'
            f' --env "UTILITY_RAS_IP={c["RAS_INTERFACE_IP"]}"'
            f' --env "CONTAINER_HOSTNAME={c["CONTAINER_HOSTNAME"]}"'
            f' --env "CONTAINER_DOMAIN_NAME={c["CONTAINER_DOMAIN_NAME"]}"'
            f' --env "UTILITY_HOST_SERIAL={serial_str}"'
            f' --env "CONTAINER_VERSION={IMAGE_VERSION}"'
        )

        if "CONTAINER_NETWORK_NAME" in c:
            cmd += f' --net {c["CONTAINER_NETWORK_NAME"]} '
        else:
            cmd += " --net podman"

        cmd += container_env_details
        cmd += f" -p {SSH_PORT}:22/tcp"
        cmd += f" --sysctl net.ipv6.conf.all.disable_ipv6=1"
        cmd += f" {IMAGE_NAME}:{IMAGE_VERSION}"

        rc = subprocess.call(cmd, shell=True)
        if rc != 0:
            print("-- [ERROR] Failed to create container --")
            print("-- Exiting... --")
            sys.exit(rc)

        print("-- [INFO] The RCL service container is being configured to start as a systemd service. --")
        print("-- [INFO] The RCL service container is set to autostart --")

        service_file = f"container-{c['CONTAINER_HOSTNAME']}.service"
        cmd = "cd ~; "
        cmd += f"podman generate systemd --files --name {c['CONTAINER_HOSTNAME']}; "
        cmd += f"sed -i '/ExecStart=/i ExecStartPre=/bin/bash -c \"until systemctl --machine=%u@.host is-active network-online.target; do sleep 2; done; until ping -c 2 127.0.0.1; do sleep 2; done; sleep 5\"' {service_file} ; "
        cmd += "mkdir -p ~/.config/systemd/user; "
        cmd += f"cp -f ~/{service_file} ~/.config/systemd/user/ ; "
        cmd += f"rm -f ~/{service_file} ; "
        cmd += f"systemctl --user enable {service_file} ; "
        cmd += "loginctl enable-linger rcladmin ; "
        rc = subprocess.call(cmd, shell=True)
        if rc != 0:
            print("-- [ERROR] Failed to setup container into systemd services --")
            print("-- Exiting... --")
            sys.exit(rc)

        print(f'-- [INFO] The container was created successfully in the background. To start this container, run the "systemctl --user start container-{c["CONTAINER_HOSTNAME"]}.service" command --')
        print(f'-- [INFO] To log in to the container, run the "podman exec -it {c["CONTAINER_HOSTNAME"]} /bin/bash" command --')
    return rc

# -----------------------------------------------------------------------------
# Install Image
# -----------------------------------------------------------------------------
def install_image_from_file(image_file_name, force):
    global IMAGE_NAME
    global IMAGE_VERSION
    rc = 1

    if force:
        print("-- [WARNING] Running image installation with -x or --force option will remove the older image forcibly --")
        cmd = f"podman image rm -f {IMAGE_NAME}:{IMAGE_VERSION}"
        rc = subprocess.call(cmd, shell=True)
        if rc != 0:
            print("-- [INFO] Removal of the podman image failed. Image doesn't exist... --")
            rc = 0

    # RESTORE CONTAINER IMAGE
    print(f"-- [INFO] Installing container image {image_file_name}")
    returned_output = subprocess.check_output(f"podman image load -i {image_file_name}", shell=True).decode()

    cmd = f"echo \"{returned_output.rstrip()}\" | grep \"Loaded image\" | awk -F\": \" '{{print $2}}'"
    _image_url = subprocess.check_output(cmd, shell=True).decode().strip()

    IMAGE_ID = subprocess.check_output(f"podman images -nq {_image_url}", shell=True).decode().strip()
    if IMAGE_ID != "":
        print(f"-- [INFO] Successfully restored image {image_file_name} into local machine with image url {_image_url}, image id is {IMAGE_ID}")
        rc = 0
    else:
        print(f"-- [ERROR] Failed to restore image {image_file_name} into local machine with url {_image_url}")
        rc = 1
        sys.exit(1)

    return rc


# -----------------------------------------------------------------------------
# Install image from repository
# -----------------------------------------------------------------------------
def install_image_from_repo(force):
    global IMAGE_NAME
    global IMAGE_VERSION
    rc = 1

    print("-- [INFO] The container image is about to be pulled from the IBM repository. --")
    if IMAGE_VERSION is None:
        print("-- [ERROR] Image version should be provided inside rclmgr.yml file... --")
        sys.exit(1)

    cmd = ""
    if force:
        print(f"-- [WARNING] The existing container image {IMAGE_NAME}:{IMAGE_VERSION} is being deleted forcefully --")
        cmd = f"podman image rm -f {IMAGE_NAME}:{IMAGE_VERSION}"
        rc = subprocess.call(cmd, shell=True)
        if rc != 0:
            print("-- [INFO] Removal of the podman image failed. Image doesn't exist... --")
            rc = 0

    cmd = f"podman pull {IMAGE_NAME}:{IMAGE_VERSION}"
    rc = subprocess.call(cmd, shell=True)
    if rc != 0:
        print("-- [ERROR] Failed to pull service container image from IBM repository... --")
        print("-- [ERROR] Login to IBM Container Repository using podman login command before starting container --")
        print("-- Exiting... --")
        rc = 1
        sys.exit(1)
    else:
        print("-- [INFO] The container image was pulled successfully. --")
        rc = 0

    return rc

# -----------------------------------------------------------------------------
# Check for enough free space
# -----------------------------------------------------------------------------
def free_space_check():
    print("-- [INFO] Checking if enough free space in /home --")
    free_space_check = "df -k --output=avail /home | tail -n1"
    output = subprocess.check_output(free_space_check, shell=True)
    if int(output) > 2000000:
        print("-- [INFO] Free space check PASSED --")
    else:
        print(
            "-- [ERROR] Not enough space in /home - Fix and re-run installer --")
        sys.exit(1)


# -----------------------------------------------------------------------------
# Check for podman installation
# -----------------------------------------------------------------------------
def check_for_podman():
    print("-- [INFO] Checking for podman version installed or needs update on node --")
    cmd = "cat /etc/redhat-release"
    returned_output = subprocess.check_output(cmd, shell=True).decode().rstrip()
    if "Red Hat Enterprise Linux release 8.8 (Ootpa)" in returned_output:
        print("Upgrading podman for RHEL 8 if required...")
        cmd = "tar zxvf podman_rh8.tgz ; cd data/podman_rh8/ ; yum -y install podman* > /dev/null 2>&1"
        subprocess.call(cmd, shell=True)

    cmd = "podman --version"
    subprocess.call(cmd, shell=True)
    print(returned_output)


# -----------------------------------------------------------------------------
# create_network
# Create podman CNI network.
# -----------------------------------------------------------------------------
def create_network(network_name):
    rc = subprocess.call(f"podman network create {network_name}", shell=True)
    if rc != 0:
        print(f"-- [ERROR] Unable to create the podman CNI network {network_name} --")
        print("-- [ERROR] Network either exists or some issue with network creation. --")
    return rc


# -----------------------------------------------------------------------------
# delete_network
# Delete the podman CNI network.
# -----------------------------------------------------------------------------
def delete_network(network_name):
    rc = subprocess.call(f"podman network remove {network_name}", shell=True)
    if rc != 0:
        print(f"-- [ERROR] Unable to delete the podman CNI network {network_name} --")
        print("-- [ERROR] Network either exists and is in use by a container, or there is some issue with network deletion. --")
        print("-- [ERROR] Inspect the running container. Verify that the network is not in use before deletion. --")
    return rc


# -----------------------------------------------------------------------------
# delete_container
# Stop and remove the container and its systemd service unit.
# -----------------------------------------------------------------------------
def delete_container():
    cont = cfg["CONTAINER"]["CONTAINER_HOSTNAME"]
    admin_user = "rcladmin"

    print(f"-- [INFO] Deleting container '{cont}' and its systemd service --")

    # Stop the service (best-effort — may already be stopped or never loaded)
    subprocess.call(f"systemctl --user stop container-{cont}.service", shell=True)

    # Force-remove the container from podman
    rc = subprocess.call(f"podman container rm -f {cont}", shell=True)
    if rc != 0:
        print(f"-- [WARNING] podman container rm -f {cont} failed (rc={rc}) — "
              f"container may not exist --")

    # Remove the generated service file and reload the daemon
    service_path = os.path.join(
        os.path.expanduser(f"~{admin_user}"), ".config", "systemd", "user",
        f"container-{cont}.service")
    if os.path.exists(service_path):
        try:
            os.remove(service_path)
            print(f"-- [INFO] Service file removed: {service_path} --")
        except OSError as exc:
            print(f"-- [ERROR] Could not remove {service_path}: {exc} --")
    else:
        print(f"-- [INFO] Service file not found (already removed?): {service_path} --")

    subprocess.call("systemctl --user daemon-reload", shell=True)
    print(f"-- [INFO] Container '{cont}' deleted. --")
    return rc


# -----------------------------------------------------------------------------
# main
# -----------------------------------------------------------------------------
def main():
    global IMAGE_NAME
    global IMAGE_VERSION

    parser = argparse.ArgumentParser(
        epilog='This script runs the Remote Code Load service container on an IBM Utility host.')

    parser.add_argument('-c', '--config', action='store',
                        default="rclmgr.yml", dest='config_file',
                        required=False,
                        help='Specify custom Config file name. '
                        'Default: rclmgr.yml')

    parser.add_argument('-x', '--force', action='store_true',
                        default=False, dest='force',
                        required=False,
                        help='Container operation with force.')

    mutual_group = parser.add_mutually_exclusive_group(required=True)

    mutual_group.add_argument('-i', '--install', action='store_true',
                              default=False, dest='install',
                              required=False,
                              help='Install container image.')
    parser.add_argument('-f', '--file', action='store',
                        default=None, dest='image_file_name',
                        required=False,
                        help='Specify the Image file name in tarball format.')

    mutual_group.add_argument('-n', '--create-network', action='store_true',
                              default=False, dest='create_network',
                              required=False,
                              help='Creates podman CNI network other than default podman CNI network')
    parser.add_argument('-net', '--network-name', action='store',
                        default="rcl_network", dest='network_name',
                        required=False,
                        help='Creates podman CNI network with default name rcl_network.')

    mutual_group.add_argument('-r', '--run', action='store_true',
                              default=False, dest='run',
                              required=False,
                              help='Runs Remote Code Load Service Container.')

    mutual_group.add_argument('-d', '--delete', action='store_true',
                              default=False, dest='delete',
                              required=False,
                              help='Delete the RCL service container and its systemd service unit.')

    input0 = parser.parse_args()
    readconf(input0)

    allow_rclmgr = os.getenv('ALLOW_RCLMGR')
    if allow_rclmgr is None:
        print("-- [WARNING] The tool 'rclmgr' has been deprecated from 6.2.3.0 and newer. Use 'startRCLcontainer' instead. --")
        sys.exit(0)
    elif allow_rclmgr == "1":
        print("-- [WARNING] The tool 'rclmgr' has been deprecated from 6.2.3.0 and newer. Proceeding since you are forcing it by export ALLOW_RCLMGR=1. Avoid using this flag out of an IBM facility. --")
    else:
        print("-- [WARNING] The tool 'rclmgr' has been deprecated from 6.2.3.0 and newer. Use 'startRCLcontainer' instead. --")
        sys.exit(0)

    # -------------------
    # Install Image
    # -------------------
    if input0.install:
        if (input0.image_file_name is None and IMAGE_NAME is None):
            print("-- [ERROR] Image tarball name using -f option or IMAGE_NAME should be inside rclmgr.yml")
            sys.exit(1)
        elif (input0.image_file_name is None and IMAGE_NAME is not None):
            rc = install_image_from_repo(input0.force)
            sys.exit(rc)
        elif (input0.image_file_name is not None):
            print("-- [INFO] Going to install image from local file installation method --")
            rc = install_image_from_file(input0.image_file_name, input0.force)
            sys.exit(rc)
        else:
            print("-- [ERROR] Image tarball name using -f option or IMAGE_NAME should be inside rclmgr.yml")
            sys.exit(1)

    # -------------------
    # Running Container
    # -------------------
    if input0.run:
        rc = 0
        rc += run_container(input0.force)
        sys.exit(rc)

    # -------------------
    # Delete Container
    # -------------------
    if input0.delete:
        rc = delete_container()
        sys.exit(rc)

    # -------------------
    # Create network
    # -------------------
    if input0.create_network:
        rc = delete_network(input0.network_name)
        if rc != 0:
            print("-- [INFO] Continuing to create the network --")
        rc += create_network(input0.network_name)
        sys.exit(rc)


if __name__ == '__main__':
    try:
        rc1 = main()
        if rc1 is not None and rc1 > 0:
            sys.exit(rc1)
    except KeyboardInterrupt:
        print(f"\n{datetime.datetime.now().isoformat()} Current task interrupted by user.")
        sys.exit(1)
    except Exception as err:
        print(f"\n{datetime.datetime.now().isoformat()} Current task terminated due to exception.")
        print(err)
        sys.exit(1)
