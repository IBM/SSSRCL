import sys
import argparse
from classes.rclmgr_yml import rclmgr_yml
import os
import shutil

ownFile = __file__


def parse_arguments():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        '-d',
        '--delete',
        action='store_true',
        dest='delete',
        help='Delete the RCL service container and its systemd service unit.',
        default=False)

    parser.add_argument(
        '-v',
        '--verbose',
        action='store_true',
        dest='verbose',
        help='Display verbose messages in the console.',
        default=False)

    # Install source: mutually exclusive — local tar file vs repo version
    install_source = parser.add_mutually_exclusive_group()

    install_source.add_argument(
        '-f',
        '--file-name',
        action='store',
        dest='filename',
        metavar='FILE',
        help='Restore the container from a local tar file. (default: SSSRCL.tar)',
        default=None)

    install_source.add_argument(
        '-vn',
        '--image-version',
        action='store',
        dest='image_version',
        metavar='VERSION',
        help='RCL Server version to be deployed. (default: 7.0.1.0)',
        default=None)

    parser.add_argument(
        '-i',
        '--campus-interface',
        action='store',
        dest='campus_interface',
        help='Name of the interface connected to the campus network. (default: campus)',
        default=None)

    args = parser.parse_args()

    if args.delete:
        start_only_args = [
            ('-f/--file-name', args.filename),
            ('-vn/--image-version', args.image_version),
            ('-i/--campus-interface', args.campus_interface),
        ]
        invalid_passed = [opt for opt, val in start_only_args if val is not None]
        if invalid_passed:
            parser.error(f"The following argument(s) cannot be used with -d/--delete: {', '.join(invalid_passed)}")

    return args.verbose, args.filename, args.campus_interface, args.image_version, \
        args.delete


def copyLogs():
    if not os.path.isdir("/var/log/rcl"):
        return
    dst_dir = "/var/log/rcl/startRCLContainer"
    if not os.path.isdir(dst_dir):
        os.mkdir(dst_dir)
    if not os.path.isdir("logs"):
        os.mkdir("logs")
    for logFile in os.listdir("logs"):
        src = os.path.join("logs", logFile)
        if os.path.isfile(src):
            shutil.copy(src, os.path.join(dst_dir, logFile))


def main():
    verbose, filename, campus_interface, image_version, delete = parse_arguments()
    our_yml = rclmgr_yml(
        verbose,
        filename,
        campus_interface,
        image_version,
        delete
    )

    if delete:
        our_yml.run_log.info("Going to delete the RCL service container.")
        our_yml.delete_container()
        sys.exit(0)

    # We need to ensure exit before this if clean up
    our_yml.run_log.debug("Going to invoke input data method from main program")
    entries_NOK = our_yml.startRCLContainer()
    if entries_NOK:
        our_yml.run_log.error(
            "The file has been written but does not pass the checks. "
            "You CANNOT continue with the next steps. "
            "Check the ERROR messages above to understand which tests failed and fix them. "
            "You can run this tool again, the data you entered will be shown as default entries."
        )
        sys.exit(1)
    else:
        our_yml.run_log.debug("Could generate the needed information into YML, going to start the RCL container")
        our_yml.run_log.debug("Going to prepare the container")
        canPrep = our_yml.prep_container()
        our_yml.run_log.debug("Back from prepare the container")
        if canPrep:
            could_start = our_yml.start_container()
            if could_start:
                our_yml.run_log.info(f"To start a new container, run the {ownFile} command.")
                sys.exit(0)
            else:
                our_yml.run_log.error(
                    "There have been some issues on the run. "
                    "Check the above messages and follow up with './startRCLContainer'."
                )
                sys.exit(5)
        else:
            our_yml.run_log.error("Could not prepare the container")
            sys.exit(6)

if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrupted by user.")
        sys.exit(1)
    finally:
        copyLogs()
